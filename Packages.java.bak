import Uday.Pack;
import java.util.Scanner;
class Packages
{
public static void main(String args[])
{
list();
}
static void list()
{
while(true)
{
	Scanner sc=new Scanner(System.in);
	System.out.println("1.Packages");
	System.out.println("2.Interfaces");
	System.out.println("3.exit");
	System.out.println("Enter your choice from 1 t0 3");
	int choice=sc.nextInt();
switch (choice)
{
case 1:Pack p=new Pack();
p.play();
p.type();
break;
case 2:
	Demo d=new demo();
		d.show();
		d.m1();
		d.m2();
		d.test();
		I1.print();
break;
case 3:System.exit(0);
default:
}
}
}
}
interface I1
{
void show();
default void test()
	{
	System.out.println("JAVA");
    }
static void print()
	{
System.out.println("OS");
	}
}
interface I2
{
void m1();
}
interface I3 extends I1,I2
{
	void m2();
}
class Demo implements I3
{
	public void show ()
	{
	System.out.println("1");
	}
	public void m1()
	{
System.out.println("2");
	}
public void m2()
	{
System.out.println("3");
	}
}
