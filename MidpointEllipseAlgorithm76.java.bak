import javax.swing.*;
import java.awt.*;
import java.awt.image.BufferedImage;
public class MidpointEllipseAlgorithm76 extends JFrame
{
private BufferedImage image;
public MidpointEllipseAlgorithm76()
	{
	setTitle("Midpoint Ellipse Algorithm");
	setSize(400,400);
	setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
	setLocationRelativeTo(null);
	image=new BufferedImage(getWidth(),getHeight(),BufferedImage.TYPE_INT_RGB);
	drawEllipseMidpoint(200,200,150,100);
	JLabel label=new JLabel(new ImageIcon(image));
	add(label);
	setVisible(true);


}
private void drawEllipseMidpoint(int centerX,int centerY,int rx,int ry)
	{
	Graphics2D g=image.createGraphics();
	g.setColor(Color.BLACK);
	int x=0;
	int y=ry;
	double d1=(ry*ry)-(rx*rx*ry)+(0.25*rx*rx);
	double dx=2*ry*ry*x;
	double dy=2*rx*rx*y;
	while(dx<dy)
		{
		drawPixel(centerX+x,centerY-y);
		drawPixel(centerX-x,centerY-y);
		drawPixel(centerX+x,centerY+y);
		drawPixel(centerX-x,centerY+y);
		x++;
		if(d1<0)
			{
			dx=dx+(2*ry*ry);
			d1=d1+dx+(ry*ry);
			}
			else
			{
				y--;
				dx=dx+(2*ry*ry);
				dy=dy-(2*rx*rx);
				d1=d1+dx-dy+(ry*ry);
			}
		}
		double d2=((ry*ry)*((x+0.5)*(x+0.5)))+
			((rx*rx)*((y-1)*(y-1)))-
			(rx*rx*ry*ry);
		while(y>=0)
		{
			drawPixel(centerX+x,centerY-y);
			drawPixel(centerX-x,centerY-y);
			drawPixel(centerX+x,centerY+y);
			drawPixel(centerX-x,centerY+y);
			y--;
			if(d2>0)
			{
				dy=dy-(2*rx*rx);
				d2=d2+(rx*rx)-dy;
			}
			else
			{
				x++;
				dx=dx+(2*ry*ry);
				dy=dy-(2*rx*rx);
				d2=d2+dx-dy+(rx*rx);
			}
		}
	}
	private void drawPixel(int x,int y)
	{
		if(x>=0 && x<getWidth() && y>=0 && y<getHeight())
		{
			image.setRGB(x,y,Color.PINK.getRGB());
		}
	}
	public static void main(String[] args)
	{
		SwingUtilities.invokeLater(()->new MidpointEllipseAlgorithm76());
	}
}
